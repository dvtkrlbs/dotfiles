{
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "terminal": {
    "dock": "bottom",
    "font_size": 13.0
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "edit_predictions": {
    "mode": "subtle"
  },
  "context_servers": {},
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "model_parameters": [],
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol"
    }
  },
  "show_edit_predictions": false,
  "buffer_font_family": "Jetbrains Mono",
  "theme": "Catppuccin Mocha",
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 16,
  "buffer_font_size": 13.0,
  "vim_mode": true,
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "diagnostics": false
      }
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
